-- BYTE RUSH for ArchOS
-- ArchScript application: only ui.window, ui.label, ui.button,
-- ui.setText and ui.notify are used from the ArchOS SDK.
-- Build this file in ArchOS Code to produce a native .archapp.

local seed = 5173
local round = 1
local maxRounds = 15
local score = 0
local best = 0
local streak = 0
local hearts = 3
local mode = 1
local correctAnswer = 0
local slot = 1
local optionA = 0
local optionB = 0
local optionC = 0
local optionD = 0
local question = ""
local status = ""
local playing = true

function nextRandom(maximum)
    seed = (seed * 73 + 41) % 9973
    return (seed % maximum) + 1
end

function updateScreen()
    ui.setText("stats_round", "ROUND " .. tostring(round) .. " / " .. tostring(maxRounds))
    ui.setText("stats_score", "SCORE  " .. tostring(score))
    ui.setText("stats_best", "BEST   " .. tostring(best))
    ui.setText("stats_streak", "STREAK " .. tostring(streak))
    ui.setText("stats_hearts", "LIVES  " .. tostring(hearts))
    if mode == 1 then
        ui.setText("stats_mode", "MODE: MATH")
    else
        ui.setText("stats_mode", "MODE: SEQUENCES")
    end
    ui.setText("question", question)
    ui.setText("answer_a", tostring(optionA))
    ui.setText("answer_b", tostring(optionB))
    ui.setText("answer_c", tostring(optionC))
    ui.setText("answer_d", tostring(optionD))
    ui.setText("status", status)
end

function makeQuestion()
    local a = nextRandom(8) + round
    local b = nextRandom(7) + 1
    if mode == 2 then
        local step = nextRandom(5) + 1
        correctAnswer = a + step * 3
        question = tostring(a) .. ", " .. tostring(a + step) .. ", " .. tostring(a + step * 2) .. ", ?"
    else
        local kind = (round - 1) % 3
        if kind == 0 then
            correctAnswer = a + b
            question = tostring(a) .. " + " .. tostring(b) .. " = ?"
        else
            if kind == 1 then
                correctAnswer = a * b
                question = tostring(a) .. " x " .. tostring(b) .. " = ?"
            else
                a = a + b
                correctAnswer = a - b
                question = tostring(a) .. " - " .. tostring(b) .. " = ?"
            end
        end
    end

    local decoyOne = correctAnswer + 1
    local decoyTwo = correctAnswer - 2
    if decoyTwo < 0 then
        decoyTwo = correctAnswer + 2
    end
    local decoyThree = correctAnswer + 4
    slot = nextRandom(4)
    optionA = decoyOne
    optionB = decoyTwo
    optionC = decoyThree
    optionD = correctAnswer
    if slot == 1 then
        optionA = correctAnswer
        optionD = decoyOne
    else
        if slot == 2 then
            optionB = correctAnswer
            optionD = decoyTwo
        else
            if slot == 3 then
                optionC = correctAnswer
                optionD = decoyThree
            end
        end
    end
    updateScreen()
end

function startRun()
    round = 1
    score = 0
    streak = 0
    hearts = 3
    playing = true
    status = "Choose A, B, C or D to answer."
    makeQuestion()
end

function finishRun()
    playing = false
    if hearts == 0 then
        status = "NO LIVES LEFT - PRESS NEW RUN"
    else
        status = "RUN COMPLETE! FINAL SCORE: " .. tostring(score)
    end
    question = "GAME OVER"
    updateScreen()
    ui.notify(status)
end

function chooseAnswer(chosen)
    if playing == false then
        status = "Press NEW RUN to play again."
        updateScreen()
        return
    end
    if chosen == slot then
        streak = streak + 1
        score = score + 100 + streak * 20
        status = "CORRECT! COMBO X" .. tostring(streak)
    else
        hearts = hearts - 1
        streak = 0
        status = "NOT QUITE. ANSWER: " .. tostring(correctAnswer)
    end
    if score > best then
        best = score
    end
    if hearts == 0 or round == maxRounds then
        finishRun()
        return
    end
    round = round + 1
    makeQuestion()
end

function onA()
    chooseAnswer(1)
end

function onB()
    chooseAnswer(2)
end

function onC()
    chooseAnswer(3)
end

function onD()
    chooseAnswer(4)
end

function onNewRun()
    startRun()
end

function onSwitchMode()
    if mode == 1 then
        mode = 2
    else
        mode = 1
    end
    startRun()
end

function onHowToPlay()
    ui.notify("Solve 15 rounds. A correct answer scores points and builds your combo. Three mistakes end the run. Switch Mode to play number sequences.")
end

ui.window("Byte Rush | ArchOS Arcade", 540, 560)
ui.label("heading", "B Y T E   R U S H", 20, 18)
ui.label("subtitle", "ARCHOS ARCADE  //  THINK FAST", 20, 49)
ui.label("separator", "-------------------------------------------------------", 20, 78)
ui.label("stats_round", "ROUND 1 / 15", 20, 105)
ui.label("stats_score", "SCORE 0", 210, 105)
ui.label("stats_best", "BEST 0", 390, 105)
ui.label("stats_hearts", "LIVES 3", 20, 138)
ui.label("stats_streak", "STREAK 0", 210, 138)
ui.label("stats_mode", "MODE: MATH", 360, 138)
ui.label("instruction", "SOLVE THIS CHALLENGE", 20, 183)
ui.label("question", "", 20, 213)
ui.button("pick_a", "A", 20, 277, "onA")
ui.label("answer_a", "", 135, 288)
ui.button("pick_b", "B", 275, 277, "onB")
ui.label("answer_b", "", 390, 288)
ui.button("pick_c", "C", 20, 334, "onC")
ui.label("answer_c", "", 135, 345)
ui.button("pick_d", "D", 275, 334, "onD")
ui.label("answer_d", "", 390, 345)
ui.label("status", "", 20, 411)
ui.button("newrun", "NEW RUN", 20, 452, "onNewRun")
ui.button("mode", "SWITCH MODE", 185, 452, "onSwitchMode")
ui.button("help", "HELP", 390, 452, "onHowToPlay")
ui.label("footer", "A tiny arcade made for the ArchOS sandbox.", 20, 514)

startRun()
